{
  "name": "Shop Notifications (orders, gift cards)",
  "nodes": [
    {"id":"0f94d2ec-87ea-4133-826e-c3ff05f9c2b5","name":"Setup","type":"n8n-nodes-base.stickyNote","typeVersion":1,"position":[-420,-60],"parameters":{"content":"## Shop notifications\nThe shop app POSTs to **<n8n>/webhook/<event>** with an `x-webhook-secret` header. Requests without the right secret are ignored.\n\n**Before activating:**\n1. On each of the 5 webhook nodes, replace `CHANGE_ME` (Options → Only Run If) with your own long random secret.\n2. Pick your SMTP credential on each Send Email node and set the **From** address.\n3. In the shop: Admin → Settings → Notifications, set the n8n URL (ending in /webhook) and the same secret.\n4. SMS is **disabled** until SMS Gate is set up: add its address + login, then enable the SMS node.","color":4,"width":380,"height":400}},
    {"id":"fc0552af-2d18-4a70-8dd1-bb337e1a5112","name":"Order Confirmed","type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[0,0],"parameters":{"httpMethod":"POST","path":"order.confirmed","responseMode":"onReceived","options":{"onlyRunIf":"={{ $json.headers['x-webhook-secret'] === 'CHANGE_ME' }}"}}},
    {"id":"5451c96d-ebc4-4c4f-acd0-e68e36ec3977","name":"Prepare Confirmation","type":"n8n-nodes-base.set","typeVersion":3.5,"position":[260,100],"parameters":{"mode":"manual","includeOtherFields":false,"assignments":{"assignments":[{"id":"c1","name":"shop","value":"={{ $json.body?.businessName || \"our shop\" }}","type":"string"},{"id":"c2","name":"orderNo","value":"={{ String($json.body?.orderId ?? \"\").slice(-6).toUpperCase() }}","type":"string"},{"id":"c3","name":"total","value":"={{ \"$\" + (Number($json.body?.total ?? 0) / 100).toFixed(2) }}","type":"string"},{"id":"c4","name":"email","value":"={{ $json.body?.customerEmail ?? \"\" }}","type":"string"},{"id":"c5","name":"phone","value":"={{ (() => { const d = String($json.body?.customerPhone ?? \"\").replace(/\\D/g, \"\"); return d.length === 10 ? \"+1\" + d : d.length === 11 && d.startsWith(\"1\") ? \"+\" + d : d ? \"+\" + d : \"\"; })() }}","type":"string"},{"id":"c6","name":"isPickup","value":"={{ $json.body?.type === \"DROP\" }}","type":"boolean"},{"id":"c7","name":"pickupWhen","value":"={{ $json.body?.pickupTime || $json.body?.pickupSlot || \"\" }}","type":"string"},{"id":"c8","name":"pickupAddress","value":"={{ $json.body?.pickupAddress || $json.body?.pickupLocation || \"\" }}","type":"string"}]}}},
    {"id":"4f3367e8-c217-4c66-88c3-4b4daa5d17a2","name":"Walk-up Purchase Paid","type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[0,200],"parameters":{"httpMethod":"POST","path":"farmstand.purchased","responseMode":"onReceived","options":{"onlyRunIf":"={{ $json.headers['x-webhook-secret'] === 'CHANGE_ME' }}"}}},
    {"id":"a8036d79-ff0d-410f-b31a-a46fd832d0cc","name":"Has Email?","type":"n8n-nodes-base.if","typeVersion":2.2,"position":[520,0],"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose"},"conditions":[{"leftValue":"={{ $json.email }}","operator":{"type":"string","operation":"notEmpty","singleValue":true},"rightValue":""}],"combinator":"and"}}},
    {"id":"b8499f2d-abd7-4047-b5af-91136c935038","name":"Email Order Confirmation","type":"n8n-nodes-base.emailSend","typeVersion":2.1,"position":[780,-40],"parameters":{"operation":"send","fromEmail":"Your Shop <hello@example.com>","toEmail":"={{ $json.email }}","subject":"={{ $json.shop }}: order #{{ $json.orderNo }} confirmed","emailFormat":"html","html":"=<div style=\"font-family:Arial,sans-serif;max-width:520px;margin:auto;color:#1c1917\"><h2 style=\"margin-bottom:4px\">Thank you for your order!</h2><p style=\"color:#57534e\">Order <b>#{{ $json.orderNo }}</b> · Total <b>{{ $json.total }}</b></p>{{ $json.isPickup ? \"<div style=\\\"background:#fafaf8;border:1px solid #e7e5e4;border-radius:12px;padding:14px;margin:16px 0\\\"><b>Pickup</b><br>\" + ($json.pickupWhen || \"\") + ($json.pickupAddress ? \"<br>\" + $json.pickupAddress.replace(/\\n/g, \"<br>\") : \"\") + \"</div>\" : \"<p>Enjoy!</p>\" }}<p style=\"color:#78716c;font-size:13px\">Questions? Just reply to this email.<br>— {{ $json.shop }}</p></div>","options":{"appendAttribution":false}},"onError":"continueRegularOutput"},
    {"id":"d2da5eda-7667-42a9-8b2d-8bdeb844edc6","name":"Has Phone?","type":"n8n-nodes-base.if","typeVersion":2.2,"position":[520,220],"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose"},"conditions":[{"leftValue":"={{ $json.phone }}","operator":{"type":"string","operation":"notEmpty","singleValue":true},"rightValue":""}],"combinator":"and"}}},
    {"id":"a4a23a68-c14b-4805-b437-3957866cf6a8","name":"Text Order Confirmation (SMS Gate)","type":"n8n-nodes-base.httpRequest","typeVersion":4.5,"position":[780,200],"parameters":{"method":"POST","url":"http://SMS-GATE-PHONE-IP:8080/message","authentication":"genericCredentialType","genericAuthType":"httpBasicAuth","sendBody":true,"contentType":"json","specifyBody":"json","jsonBody":"={{ JSON.stringify({ phoneNumbers: [$json.phone], message: $json.shop + \": order #\" + $json.orderNo + \" is confirmed (\" + $json.total + \").\" + ($json.isPickup && $json.pickupWhen ? \" Pickup: \" + $json.pickupWhen + \".\" : \"\") + ($json.isPickup && $json.pickupAddress ? \" \" + $json.pickupAddress.replace(/\\n/g, \", \") : \"\") + \" Reply STOP to opt out.\" }) }}"},"disabled":true,"onError":"continueRegularOutput"},
    {"id":"0a706da2-4d7d-4889-b920-79044aed6abc","name":"Venmo/PayPal Order To Confirm","type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[0,520],"parameters":{"httpMethod":"POST","path":"order.awaiting_payment","responseMode":"onReceived","options":{"onlyRunIf":"={{ $json.headers['x-webhook-secret'] === 'CHANGE_ME' }}"}}},
    {"id":"57a7c683-a3ae-4e8f-b74e-2f0a4c0514ae","name":"Email Owner: Check Payment","type":"n8n-nodes-base.emailSend","typeVersion":2.1,"position":[520,520],"parameters":{"operation":"send","fromEmail":"Your Shop <hello@example.com>","toEmail":"={{ $json.body?.ownerEmail }}","subject":"=New {{ $json.body?.paymentMethod === \"PAYPAL\" ? \"PayPal\" : $json.body?.paymentMethod === \"VENMO\" ? \"Venmo\" : \"\" }} order #{{ String($json.body?.orderId ?? \"\").slice(-6).toUpperCase() }} – check for {{ \"$\" + (Number($json.body?.total ?? 0) / 100).toFixed(2) }}","emailFormat":"html","html":"=<div style=\"font-family:Arial,sans-serif;max-width:520px;color:#1c1917\"><h3>New {{ $json.body?.type === \"GIFT\" ? \"gift card\" : \"order\" }} waiting for payment</h3><p><b>{{ \"$\" + (Number($json.body?.total ?? 0) / 100).toFixed(2) }}</b> via {{ $json.body?.paymentMethod }}</p><p>{{ $json.body?.customerName || \"\" }}<br>{{ $json.body?.customerEmail || \"\" }}<br>{{ $json.body?.customerPhone || \"\" }}</p><p>{{ ($json.body?.items || []).map(i => i.quantity + \" × \" + i.name).join(\"<br>\") }}</p>{{ $json.body?.pickupTime ? \"<p>Pickup: \" + $json.body.pickupTime + \"</p>\" : \"\" }}{{ $json.body?.notes ? \"<p>Notes: \" + $json.body.notes + \"</p>\" : \"\" }}<p>When the money arrives, mark it <b>Paid</b>: <a href=\"{{ $json.body?.adminUrl }}\">{{ $json.body?.adminUrl }}</a></p></div>","options":{"appendAttribution":false}}},
    {"id":"6f3f18c5-e198-4095-a483-67849b3c4e89","name":"Order Cancelled","type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[0,760],"parameters":{"httpMethod":"POST","path":"order.cancelled","responseMode":"onReceived","options":{"onlyRunIf":"={{ $json.headers['x-webhook-secret'] === 'CHANGE_ME' }}"}}},
    {"id":"090a1ba5-b1a3-4014-82ac-1bef6e889047","name":"Customer Has Email?","type":"n8n-nodes-base.if","typeVersion":2.2,"position":[260,760],"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose"},"conditions":[{"leftValue":"={{ $json.body?.customerEmail ?? \"\" }}","operator":{"type":"string","operation":"notEmpty","singleValue":true},"rightValue":""}],"combinator":"and"}}},
    {"id":"86f02e0d-c91c-4435-8472-e8282c376b0d","name":"Email Cancellation","type":"n8n-nodes-base.emailSend","typeVersion":2.1,"position":[520,740],"parameters":{"operation":"send","fromEmail":"Your Shop <hello@example.com>","toEmail":"={{ $json.body?.customerEmail }}","subject":"={{ $json.body?.businessName || \"Your order\" }}: order #{{ String($json.body?.orderId ?? \"\").slice(-6).toUpperCase() }} {{ $json.body?.status === \"REFUNDED\" ? \"refunded\" : \"cancelled\" }}","emailFormat":"html","html":"=<div style=\"font-family:Arial,sans-serif;max-width:520px;color:#1c1917\"><p>Your order <b>#{{ String($json.body?.orderId ?? \"\").slice(-6).toUpperCase() }}</b> ({{ \"$\" + (Number($json.body?.total ?? 0) / 100).toFixed(2) }}) has been {{ $json.body?.status === \"REFUNDED\" ? \"refunded\" : \"cancelled\" }}.</p><p style=\"color:#78716c;font-size:13px\">If you have questions, just reply to this email.<br>— {{ $json.body?.businessName || \"\" }}</p></div>","options":{"appendAttribution":false}}},
    {"id":"081bed8d-4874-4a73-bbc0-b6cc9db277b1","name":"Gift Card Activated","type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[0,1000],"parameters":{"httpMethod":"POST","path":"gift.activated","responseMode":"onReceived","options":{"onlyRunIf":"={{ $json.headers['x-webhook-secret'] === 'CHANGE_ME' }}"}}},
    {"id":"9684e6d6-2f88-4c74-a0cd-fe6f524a2007","name":"Prepare Gift Card","type":"n8n-nodes-base.set","typeVersion":3.5,"position":[260,1000],"parameters":{"mode":"manual","includeOtherFields":false,"assignments":{"assignments":[{"id":"g1","name":"shop","value":"={{ $json.body?.businessName || \"our shop\" }}","type":"string"},{"id":"g2","name":"code","value":"={{ $json.body?.code }}","type":"string"},{"id":"g3","name":"amount","value":"={{ \"$\" + (Number($json.body?.amount ?? 0) / 100).toFixed(2) }}","type":"string"},{"id":"g4","name":"to","value":"={{ $json.body?.recipientEmail || $json.body?.purchaserEmail || \"\" }}","type":"string"},{"id":"g5","name":"recipientName","value":"={{ $json.body?.recipientName || \"\" }}","type":"string"},{"id":"g6","name":"fromName","value":"={{ $json.body?.fromName || \"\" }}","type":"string"},{"id":"g7","name":"message","value":"={{ $json.body?.message || \"\" }}","type":"string"},{"id":"g8","name":"shopUrl","value":"={{ $json.body?.shopUrl || \"\" }}","type":"string"},{"id":"g9","name":"purchaserEmail","value":"={{ $json.body?.purchaserEmail || \"\" }}","type":"string"},{"id":"g10","name":"sendReceipt","value":"={{ !!$json.body?.purchaserEmail && !!$json.body?.recipientEmail && $json.body.purchaserEmail !== $json.body.recipientEmail }}","type":"boolean"}]}}},
    {"id":"3bd6ed6b-7fcd-42f2-a3d6-cbf661d7dbf6","name":"Has Someone To Email?","type":"n8n-nodes-base.if","typeVersion":2.2,"position":[520,940],"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose"},"conditions":[{"leftValue":"={{ $json.to }}","operator":{"type":"string","operation":"notEmpty","singleValue":true},"rightValue":""}],"combinator":"and"}}},
    {"id":"ff13f899-936a-4715-aacf-427684d53da0","name":"Email Gift Card Code","type":"n8n-nodes-base.emailSend","typeVersion":2.1,"position":[780,900],"parameters":{"operation":"send","fromEmail":"Your Shop <hello@example.com>","toEmail":"={{ $json.to }}","subject":"={{ $json.fromName ? $json.fromName + \" sent you\" : \"Your\" }} {{ $json.amount }} gift card for {{ $json.shop }} 🎁","emailFormat":"html","html":"=<div style=\"font-family:Arial,sans-serif;max-width:520px;margin:auto;color:#1c1917;text-align:center\"><h2>{{ $json.recipientName ? \"Hi \" + $json.recipientName + \"!\" : \"You have a gift card!\" }}</h2><p>{{ $json.fromName ? $json.fromName + \" sent you\" : \"Here is\" }} a <b>{{ $json.amount }}</b> gift card for {{ $json.shop }}.</p>{{ $json.message ? \"<p style=\\\"font-style:italic;color:#57534e\\\">“\" + $json.message + \"”</p>\" : \"\" }}<div style=\"font-size:22px;font-weight:bold;letter-spacing:2px;border:2px dashed #d6d3d1;border-radius:12px;padding:16px;margin:20px 0\">{{ $json.code }}</div><p>Enter this code in the <b>Gift Card</b> box at checkout. Any balance left stays on the card.</p>{{ $json.shopUrl ? \"<p><a href=\\\"\" + $json.shopUrl + \"\\\">\" + $json.shopUrl + \"</a></p>\" : \"\" }}</div>","options":{"appendAttribution":false}},"onError":"continueRegularOutput"},
    {"id":"fee6be13-8c85-4b6f-86ca-ec6d67b0a7e0","name":"Buyer Needs Receipt?","type":"n8n-nodes-base.if","typeVersion":2.2,"position":[520,1120],"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose"},"conditions":[{"leftValue":"={{ $json.sendReceipt }}","operator":{"type":"boolean","operation":"true","singleValue":true},"rightValue":""}],"combinator":"and"}}},
    {"id":"e25a9d71-61e9-4410-b179-c95df570f4dd","name":"Email Buyer Receipt","type":"n8n-nodes-base.emailSend","typeVersion":2.1,"position":[780,1100],"parameters":{"operation":"send","fromEmail":"Your Shop <hello@example.com>","toEmail":"={{ $json.purchaserEmail }}","subject":"=Your {{ $json.amount }} gift card was sent","emailFormat":"html","html":"=<div style=\"font-family:Arial,sans-serif;max-width:520px;color:#1c1917\"><p>Thanks! Your <b>{{ $json.amount }}</b> {{ $json.shop }} gift card has been emailed to {{ $json.recipientName || $json.to }}.</p><p>Gift card code (keep for your records): <b>{{ $json.code }}</b></p></div>","options":{"appendAttribution":false}},"onError":"continueRegularOutput"}
