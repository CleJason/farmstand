// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Auth (NextAuth v5 adapter models)
// ─────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────
// Users & Customers
// ─────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  role          String    @default("CUSTOMER")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  orders   Order[]
}

// ─────────────────────────────────────────────
// Products (master catalog)
// ─────────────────────────────────────────────

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Int      // stored in cents
  imageUrl    String?
  imagePosition String? // which part of the photo shows in the square, e.g. "50% 30%"
  category    String?
  active      Boolean  @default(true)
  // Mix & match box: the customer picks `boxSize` items from `boxOptions`
  // (e.g. a 6-cookie box from 4 flavors). null = a normal product.
  boxSize     Int?
  boxOptions  String[] @default([])
  // Optional extras the customer can tick, e.g. [{ "name": "Extra icing", "price": 100 }] (cents, per item)
  addOns      Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  dropProducts DropProduct[]
}

// ─────────────────────────────────────────────
// Drops (weekly pickup events)
// ─────────────────────────────────────────────

model Drop {
  id            String   @id @default(cuid())
  title         String
  description   String?
  orderOpenAt   DateTime   // when ordering opens (e.g. Monday 6am)
  orderCloseAt  DateTime   // cutoff (e.g. Wednesday 11:59pm)
  status        String     @default("DRAFT")
  maxOrders     Int?       // optional cap on total orders
  announcedAt   DateTime?  // when the "new drop" alert went to subscribers (sent once)
  reminderSentAt DateTime? // when the "closing soon" reminder went out (sent once)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  pickupSlots  PickupSlot[]
  dropProducts DropProduct[]
  orders       Order[]
}

// Each drop can have multiple pickup windows (e.g. Friday 4-6pm, Saturday 9-11am).
// Customers pick a time inside the window every `intervalMinutes`
// (start and end included), optionally capped at `maxPerTime` orders per time.
model PickupSlot {
  id              String    @id @default(cuid())
  dropId          String
  label           String    // e.g. "Fri, Oct 9 · 4:00–6:00 PM"
  pickupDate      DateTime  // window start
  endDate         DateTime? // window end; null = a single pickup time
  location        String?   // public area, e.g. "Springfield, Ohio"
  address         String?   // exact address — only revealed to customers once paid
  intervalMinutes Int       @default(30)
  maxPerTime      Int?      // null = unlimited
  drop            Drop      @relation(fields: [dropId], references: [id], onDelete: Cascade)
  orders          Order[]
}

// Products offered within a specific drop, with per-drop qty limits
model DropProduct {
  id             String   @id @default(cuid())
  dropId         String
  productId      String
  priceOverride  Int?     // override master price for this drop (cents)
  quantityLimit  Int?     // how many offered this week (null = unlimited)
  quantitySold   Int      @default(0)
  boxOptions     String[] @default([]) // mix & match box: choices offered this drop (empty = all of the product's)
  drop           Drop     @relation(fields: [dropId], references: [id], onDelete: Cascade)
  product        Product  @relation(fields: [productId], references: [id])
  orderItems     OrderItem[]

  @@unique([dropId, productId])
}

// ─────────────────────────────────────────────
// Farmstand (walk-up / QR kiosk inventory)
// ─────────────────────────────────────────────

model FarmstandItem {
  id                String   @id @default(cuid())
  name              String
  description       String?
  price             Int      // cents
  imageUrl          String?
  imagePosition     String?  // e.g. "50% 30%"
  available         Boolean  @default(false) // admin toggles on when extras go out
  quantityAvailable Int      @default(0)     // set each time extras go out
  quantitySold      Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  orderItems OrderItem[]
}

// ─────────────────────────────────────────────
// Orders
// ─────────────────────────────────────────────

model Order {
  id              String   @id @default(cuid())
  userId          String?       // null for guest farmstand purchases
  type            String        // DROP or FARMSTAND
  dropId          String?
  pickupSlotId    String?
  pickupTime      DateTime?     // the time the customer chose inside the pickup window
  status          String   @default("PENDING")
  paymentMethod   String   @default("STRIPE")
  subtotal        Int           // cents
  discountCode    String?       // code applied at checkout, if any
  discount        Int      @default(0) // cents taken off the subtotal
  giftCode        String?       // gift card used to pay part/all of this order
  giftAmount      Int      @default(0) // cents paid from that gift card
  total           Int           // cents left to pay (subtotal - discount - giftAmount)
  notes           String?
  // Guest info (farmstand — no login required)
  guestName       String?
  guestEmail      String?
  guestPhone      String?
  // Stripe
  stripePaymentIntentId String? @unique
  stripeClientSecret    String?
  // PayPal/Venmo manual reference
  manualPaymentRef      String?
  // "How was it?" email after pickup (not every order: see lib/review-requests)
  reviewToken     String?  @unique
  reviewRequestedAt DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user        User?       @relation(fields: [userId], references: [id])
  drop        Drop?       @relation(fields: [dropId], references: [id])
  pickupSlot  PickupSlot? @relation(fields: [pickupSlotId], references: [id])
  items       OrderItem[]
  payment     Payment?
}

model OrderItem {
  id                String   @id @default(cuid())
  orderId           String
  // one of these will be set
  dropProductId     String?
  farmstandItemId   String?
  quantity          Int
  priceAtPurchase   Int      // cents — snapshot at time of order
  selections        Json?    // mix & match box picks: [{ name, quantity }] per box
  addOns            Json?    // extras chosen: [{ name, price }] (price included in priceAtPurchase)
  createdAt         DateTime @default(now())

  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dropProduct   DropProduct?   @relation(fields: [dropProductId], references: [id])
  farmstandItem FarmstandItem? @relation(fields: [farmstandItemId], references: [id])
}

// ─────────────────────────────────────────────
// Payments
// ─────────────────────────────────────────────

model Payment {
  id                    String   @id @default(cuid())
  orderId               String   @unique
  stripePaymentIntentId String?
  amount                Int           // cents
  status                String   @default("PENDING")
  method                String   @default("STRIPE")
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// Discount codes & reviews
// ─────────────────────────────────────────────

model DiscountCode {
  id          String    @id @default(cuid())
  code        String    @unique  // stored uppercase
  type        String              // PERCENT | AMOUNT
  value       Int                 // percent (1-100) or cents off
  appliesTo   String    @default("ALL") // ALL | DROP | FARMSTAND
  minSubtotal Int?                // cents; null = no minimum
  maxUses     Int?                // null = unlimited
  uses        Int       @default(0) // counted like stock: placed/paid orders only
  allowedEmails String[] @default([]) // personal code: only these customers (lowercase); empty = anyone
  expiresAt   DateTime?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Gift cards: bought online (an Order of type GIFT) or created by the owner.
// Spent across orders until the balance runs out.
model GiftCertificate {
  id             String   @id @default(cuid())
  code           String   @unique // e.g. GIFT-AB12-CD34
  initialAmount  Int               // cents
  balance        Int               // cents left
  status         String   @default("PENDING") // PENDING (awaiting payment) | ACTIVE | VOID
  recipientName  String?
  recipientEmail String?
  fromName       String?
  message        String?
  purchaserEmail String?
  orderId        String?  @unique  // the GIFT order that bought it (null = created by owner)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Added by the owner (e.g. copied from another platform); shown on the home page
model Review {
  id         String   @id @default(cuid())
  name       String
  rating     Int      // 1-5
  body       String
  source     String?  // e.g. "Hotplate"
  products   String?  // products it's about, comma-separated, e.g. "Mini Cinnamon Rolls, The Sunday Roll"
  reply      String?  // the owner's public reply
  images     String[] @default([]) // photos, e.g. "/uploads/123-abc.jpg" (up to 4)
  // Left by a customer through the emailed review link (owner-added reviews have none)
  email      String?  // stored lowercase; never shown publicly
  orderId    String?  @unique // one review per order
  rewardCode String?  // thank-you discount code sent for their first review
  reviewDate DateTime @default(now())
  visible    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Customers added by the owner (by hand or imported from Hotplate etc.).
// Shown in Admin → Customers, merged with orders by email or phone.
model Contact {
  id        String   @id @default(cuid())
  name      String?
  email     String?  @unique // stored lowercase
  phone     String?          // digits only, e.g. 5551234567
  // Earlier emails/numbers, kept so orders placed with them stay with this customer
  otherEmails String[] @default([])
  otherPhones String[] @default([])
  // History brought over from another platform (e.g. Hotplate's customer export)
  importedOrders  Int       @default(0)
  importedSpent   Int       @default(0) // cents
  firstOrderAt    DateTime?
  lastOrderAt     DateTime?
  customerSince   DateTime?
  note            String?
  createdAt DateTime @default(now())

  @@index([phone])
}

// Customers who asked not to get "How was it?" review emails
model ReviewOptOut {
  email     String   @id // lowercase
  createdAt DateTime @default(now())
}

// Text conversations shown in Admin → Messages (incoming texts and the owner's replies)
model SmsMessage {
  id        String   @id @default(cuid())
  phone     String   // digits, e.g. 5551234567
  direction String   // IN | OUT
  body      String
  read      Boolean  @default(false) // incoming: seen in Admin yet
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
}

// Numbers that replied STOP: never texted again (until they reply START)
model SmsOptOut {
  phone     String   @id // digits, e.g. 5551234567
  createdAt DateTime @default(now())
}

// People who signed up on the home page to hear about new drops
model Subscriber {
  id          String   @id @default(cuid())
  email       String?  @unique // stored lowercase; null = phone only (text alerts)
  phone       String?          // digits, for text alerts
  unsubscribeToken String @unique @default(cuid())
  dropAlerts  Boolean  @default(true)  // "drop is open" and "last call" alerts
  dropVia     String?  // how they want drop alerts: text | email | both (empty = signed up before there was a choice)
  standAlerts Boolean  @default(false) // "Porch Pickup is open" alerts (walk-up page)
  standVia    String   @default("text") // how they want those: text | email | both
  createdAt   DateTime @default(now())

  @@index([phone])
}

// When the walk-up (Porch Pickup) stand is open, set week by week in the admin
model StandHours {
  id        String   @id @default(cuid())
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime @default(now())

  @@index([endsAt])
}

// ─────────────────────────────────────────────
// Costs (Admin → Costs): what ingredients cost, and what each recipe costs to make
// ─────────────────────────────────────────────

// Something the shop buys: an ingredient or packaging (boxes, liners, labels).
// Costs are tracked per base unit: grams, milliliters or pieces.
model Ingredient {
  id          String   @id @default(cuid())
  name        String   @unique
  baseUnit    String   @default("g") // g | ml | pc
  gramsPerCup Float?   // how much 1 cup weighs, so cups/tbsp/tsp price right (and grams for liquids)
  manualCost  Float?   // $ per base unit, for things never bought through the log (e.g. labor)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchases   IngredientPurchase[]
  recipeLines RecipeLine[]
  counts      StockCount[]
}

// "There's actually this much on the shelf": on hand = this + purchases since − baking since
model StockCount {
  id           String     @id @default(cuid())
  ingredientId String
  date         DateTime   @default(now())
  amount       Float      // in the ingredient's base unit
  createdAt    DateTime   @default(now())
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([ingredientId, date])
}

// One line on a receipt: 5440 g of bread flour from Costco for $9.79
model IngredientPurchase {
  id           String     @id @default(cuid())
  ingredientId String
  date         DateTime
  store        String?
  quantity     Float      // in the ingredient's base unit
  price        Int        // cents paid for that quantity
  createdAt    DateTime   @default(now())
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([ingredientId])
  @@index([date])
}

// A whole receipt (business expense), like the "2026 Expenses" sheet: the
// ingredient lines on it can also be logged as IngredientPurchases
model Receipt {
  id          String   @id @default(cuid())
  date        DateTime
  vendor      String
  amount      Int      // cents, the receipt total
  description String?  // what was bought
  category    String?  // Ingredients, Packaging, Equipment, Website & software, Other
  imageUrl    String?  // photo of the receipt (/uploads/…)
  createdAt   DateTime @default(now())

  @@index([date])
}

model Recipe {
  id            String   @id @default(cuid())
  name          String   @unique
  yieldCount    Float    @default(1)       // how many it makes
  yieldLabel    String   @default("items") // "cookies", "rolls"…
  overheadHours Float    @default(0)       // bake/labor hours, at the overhead rate
  sellPrice     Int?     // cents
  sellPer       String   @default("batch") // the price is for the whole batch, or per "item"
  notes         String?
  source        String?  // where it came from: "sheet" or "mealie"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lines         RecipeLine[]
  links         RecipeLink[]
  bakes         Bake[]
  itemsOut      ItemOut[]
}

// What a recipe is sold as: a product's name, or a box option ("Chocolate Chip"
// in a 6-cookie box). Each one sold uses `itemsPerUnit` of what the recipe makes.
model RecipeLink {
  id           String @id @default(cuid())
  name         String @unique // stored lowercase
  recipeId     String
  itemsPerUnit Float  @default(1)
  recipe       Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}

// Batches baked (for a drop, the porch, trying a new recipe…): uses up ingredients
model Bake {
  id        String   @id @default(cuid())
  recipeId  String
  date      DateTime @default(now())
  batches   Float
  reason    String   @default("other") // drop | porch | test | other
  dropId    String?
  note      String?
  usage     Json     @default("[]") // [{ ingredientId, amount }] in base units, as the recipe was then
  cost      Int      @default(0)    // cents, ingredients + overhead, as it was then
  createdAt DateTime @default(now())
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([date])
}

// Baked items that didn't sell: given away (to win next week's order), tasted, tossed
model ItemOut {
  id        String   @id @default(cuid())
  recipeId  String
  date      DateTime @default(now())
  count     Float
  reason    String   @default("giveaway") // giveaway | tasting | tossed
  note      String?
  cost      Int      @default(0) // cents, per-item cost × count, as it was then
  createdAt DateTime @default(now())
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([date])
}

model RecipeLine {
  id           String     @id @default(cuid())
  recipeId     String
  ingredientId String
  quantity     Float
  unit         String     // g, kg, oz, lb, ml, cup, tbsp, tsp, pc…
  note         String?
  position     Int        @default(0)
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@index([recipeId])
  @@index([ingredientId])
}

// ─────────────────────────────────────────────
// Notification Log
// ─────────────────────────────────────────────

model NotificationLog {
  id        String   @id @default(cuid())
  event     String   // e.g. "order.confirmed", "drop.announced"
  recipient String   // email or phone
  channel   String   // "sms" | "email"
  payload   String   // JSON string instead of Json type
  success   Boolean
  error     String?
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────
// App Settings (key-value store for setup wizard)
// ─────────────────────────────────────────────

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
