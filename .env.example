# Copy to .env and fill in. Most settings below can ALSO be set in the app
# under Admin → Settings (values saved there win over this file).

# ─────────────────────────────────────────────
# Database (docker-compose creates Postgres with these)
# ─────────────────────────────────────────────
POSTGRES_USER=farmstand
POSTGRES_PASSWORD=change_me_letters_and_numbers
POSTGRES_DB=farmstand

# Set automatically by docker-compose. For local dev (npm run dev), run
# `docker compose up -d postgres` then `npx prisma migrate deploy`.
DATABASE_URL=postgresql://farmstand:change_me_letters_and_numbers@localhost:5432/farmstand?schema=public

# ─────────────────────────────────────────────
# Sign-in (required)
# ─────────────────────────────────────────────
# Who can be admin (comma-separated). Only these emails can finish /setup or
# open Admin; everyone else who signs in is a customer.
ADMIN_EMAIL=you@example.com
# Long random string: openssl rand -base64 32. Keep it the same between updates.
AUTH_SECRET=
# Public address of the site (used in sign-in links)
NEXTAUTH_URL=https://shop.example.com
NEXT_PUBLIC_APP_URL=https://shop.example.com
# Needed behind Cloudflare Tunnel / a reverse proxy
AUTH_TRUST_HOST=true

# ─────────────────────────────────────────────
# Sign-in email (SMTP) — or set in Admin → Settings → Email
# Use an app password from your provider, not your normal password.
# ─────────────────────────────────────────────
EMAIL_SERVER_HOST=smtp.example.com
EMAIL_SERVER_PORT=465
EMAIL_SERVER_USER=you@example.com
EMAIL_SERVER_PASS=
EMAIL_FROM="Your Shop <you@example.com>"

# ─────────────────────────────────────────────
# Payments (optional) — or set in Admin → Settings → Payments
# ─────────────────────────────────────────────
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_PAYPAL_ME_USERNAME=
NEXT_PUBLIC_VENMO_USERNAME=

# ─────────────────────────────────────────────
# Notifications via n8n (optional) — or set in Admin → Settings
# Events are POSTed to <base>/<event>: order.confirmed, order.awaiting_payment
# (owner alert for Venmo/PayPal orders), order.cancelled, farmstand.purchased.
# Customer emails and SMS are sent by n8n; SMS goes through SMS Gate, which is
# configured in n8n/order-notifications-workflow.json, not in this app.
# ─────────────────────────────────────────────
N8N_WEBHOOK_BASE_URL=
N8N_WEBHOOK_SECRET=

# ─────────────────────────────────────────────
# Container
# ─────────────────────────────────────────────
# Owner of uploaded files on the host (Unraid: 99/100)
PUID=99
PGID=100
